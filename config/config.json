{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "upload-and-tag-command-set": {
      "components": [
        {
          "entrypoint": "./lib/extensions/uploadAndTag/UploadAndTagCommandSet.js",
          "manifest": "./src/extensions/uploadAndTag/UploadAndTagCommandSet.manifest.json"
        }
      ]
    },
    "vessel-email-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/vesselEmail/VesselEmailWebPart.js",
          "manifest": "./src/webparts/vesselEmail/VesselEmailWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "UploadAndTagCommandSetStrings": "lib/extensions/uploadAndTag/loc/{locale}.js",
    "VesselEmailWebPartStrings": "lib/webparts/vesselEmail/loc/{locale}.js"
  }
}
